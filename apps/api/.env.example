DATABASE_URL="postgresql://imeceburada:imeceburada@localhost:5432/imeceburada?schema=public"
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3001

# iyzico abonelik (üyelik/ödeme) entegrasyonu — sandbox hesabı açılınca doldurulacak
IYZICO_API_KEY=""
IYZICO_SECRET_KEY=""
IYZICO_MERCHANT_ID=""
IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"
# iyzico panelinden ürün+fiyat planı oluşturulduktan sonra buraya referans kodları girilir
IYZICO_PRICING_PLAN_MONTHLY=""
IYZICO_PRICING_PLAN_YEARLY=""

# Resend (https://resend.com) — şifre sıfırlama e-postaları için. Boş bırakılırsa
# e-posta gönderilmez, link sadece sunucu loglarına yazılır (yerel geliştirme).
RESEND_API_KEY=""
# Kendi alan adın Resend'de doğrulanana kadar boş bırak — varsayılan olarak
# Resend'in paylaşımlı test adresi (onboarding@resend.dev) kullanılır.
RESEND_FROM_ADDRESS=""

# Netgsm (https://www.netgsm.com.tr) — telefon doğrulama/telefonla giriş SMS
# kodları için. NETGSM_USERCODE boş bırakılırsa SMS gönderilmez, kod sadece
# sunucu loglarına yazılır (yerel geliştirme).
NETGSM_USERCODE=""
NETGSM_PASSWORD=""
# Netgsm panelinde onaylattığın gönderici başlığı (örn. "İMECE" gibi bir marka adı)
NETGSM_HEADER=""

WEB_BASE_URL="http://localhost:3000"
# WEB_BASE_URL zaten CORS izinli origin listesine dahildir; başka origin'lere
# (ör. mobil web build'i) izin vermek için virgülle ayırarak ekle
CORS_ORIGINS=""

# Erken Erişim/Beta dönemi: true (veya tanımsız) iken kurumsal hesaplar için
# üyelik/ödeme zorunluluğu tamamen devre dışıdır. Ücretli döneme geçerken
# sadece bunu "false" yap — kod değişikliği gerekmez.
BETA_FREE_ACCESS="true"
