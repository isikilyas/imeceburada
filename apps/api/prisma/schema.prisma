generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CANDIDATE
  COMPANY
  SUPPLIER
  SUBCONTRACTOR
  ADMIN
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  DAILY
  CONTRACT
}

enum JobStatus {
  ACTIVE
  CLOSED
}

enum ApplicationStatus {
  PENDING
  REVIEWED
  ACCEPTED
  REJECTED
}

enum WagePeriod {
  DAILY
  MONTHLY
  HOURLY
}

enum ExperienceLevel {
  JUNIOR
  MID
  SENIOR
}

enum PriceSubmissionType {
  ACTUAL
  OFFER
}

enum AvailabilityStatus {
  AVAILABLE
  BUSY
}

enum EquipmentStatus {
  AVAILABLE
  RENTED
  SOLD
  INACTIVE
}

enum EquipmentListingType {
  RENT
  SALE
}

enum SiteRequestType {
  WORKER
  EQUIPMENT
}

enum SiteRequestStatus {
  OPEN
  CLOSED
}

enum SiteRequestResponseStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum MembershipStatus {
  NONE
  PENDING
  ACTIVE
  EXPIRED
  CANCELED
}

enum MembershipPlan {
  MONTHLY
  YEARLY
}

enum MaterialListingStatus {
  AVAILABLE
  INACTIVE
}

/// Akıllı doğrulama kapsamındaki, geçmişte kapalı liste olan alanlar — bkz. TaxonomyTerm.
enum TaxonomyTermType {
  TRADE_PROFESSION
  MATERIAL_TYPE
  MATERIAL_CATEGORY_ITEM
  EQUIPMENT_TYPE
}

enum TaxonomyTermStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String?  @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastLoginAt  DateTime?

  /// Şu an sadece ADMIN hesap panelinde kullanılıyor — diğer roller için
  /// unvan/meslek bilgisi zaten kendi profil modellerinde ayrıca tutuluyor.
  title        String?

  /// Girişte imzalanan JWT'lere gömülür — "tüm cihazlardan çıkış yap"
  /// tetiklendiğinde bir artırılır, bu da daha önce dağıtılmış tüm
  /// access/refresh token'ları (stateless oldukları için tek tek iptal
  /// edilemedikleri halde) geçersiz kılar.
  tokenVersion Int      @default(0)

  passwordResetTokenHash    String?
  passwordResetExpiresAt    DateTime?

  /// Kullanıcının kendi isteğiyle hesabını geçici olarak dondurması —
  /// dolu olduğu sürece giriş dışındaki tüm oturumlu istekler reddedilir ve
  /// hesap tüm dizin/ilan listelerinden gizlenir; bir sonraki başarılı
  /// girişte otomatik olarak temizlenir (hesap yeniden aktifleşir).
  deactivatedAt DateTime?

  /// Oturum açıkken e-posta değiştirme akışı — yeni adrese doğrulama kodu
  /// gönderilir, kod onaylanana kadar `email` değişmez.
  pendingEmail          String?
  emailChangeCode       String?
  emailChangeExpiresAt  DateTime?

  candidateProfile         CandidateProfile?
  companyProfile           CompanyProfile?
  supplierProfile          SupplierProfile?
  subcontractorProfile     SubcontractorProfile?
  wageSubmissions          WageSubmission[]
  materialPriceSubmissions MaterialPriceSubmission[]
  equipmentListings        EquipmentListing[]
  siteRequestsCreated      SiteRequest[]
  siteRequestResponses     SiteRequestResponse[]
  favorites                Favorite[]
  submittedTaxonomyTerms   TaxonomyTerm[]            @relation("SubmittedTaxonomyTerms")
  reviewedTaxonomyTerms    TaxonomyTerm[]             @relation("ReviewedTaxonomyTerms")
  addresses                Address[]
  sentMessages             Message[]
  authoredReviews          Review[]                  @relation("AuthoredReviews")
  receivedReviews          Review[]                  @relation("ReceivedReviews")

  @@map("users")
}

model CandidateProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName            String
  phone               String?
  /// Telefon numarasının başka kullanıcılara (ilan detayı, dizin) gösterilip
  /// gösterilmeyeceği — varsayılan kapalı, kullanıcı kendi rızasıyla açar.
  phoneVisible        Boolean  @default(false)
  phoneVerifiedAt             DateTime?
  phoneVerificationCode       String?
  phoneVerificationExpiresAt  DateTime?
  city                String
  district            String?
  /// Açık adres — sadece kullanıcının kendi Hesabım panelinde görünür,
  /// hiçbir dizin/ilan yanıtında başka kullanıcılara gösterilmez.
  address             String?
  /// Hakkımda / kısa biyografi.
  bio                 String?
  experienceYears     Int      @default(0)
  skills              String[] @default([])
  workPreferences     String[] @default([])
  primaryTradeCategory String?
  isPublic            Boolean  @default(false)
  photoUrl            String?
  photoVisible        Boolean  @default(true)
  availabilityStatus  AvailabilityStatus @default(AVAILABLE)
  /// Başvuru durumu değiştiğinde e-posta bildirimi alınsın mı — Hesabım > Bildirimler'den yönetilir.
  notifyByEmail       Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  applications  Application[]
  conversations Conversation[]

  @@index([isPublic, primaryTradeCategory, city, district])
  @@index([phone])
  @@map("candidate_profiles")
}

model CompanyProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String
  sector      String?
  city        String
  district    String?
  /// Açık adres — sadece kullanıcının kendi Hesabım panelinde görünür.
  address     String?
  description String?
  authorizedPersonName String?
  taxOffice            String?
  taxNumber            String?
  mersisNumber         String?
  website              String?
  /// Hesabın giriş e-postasından bağımsız, isteğe bağlı firma iletişim e-postası.
  companyEmail         String?
  logoUrl              String?

  phone                       String?
  /// Telefon numarasının başka kullanıcılara gösterilip gösterilmeyeceği —
  /// varsayılan kapalı, kullanıcı kendi rızasıyla açar.
  phoneVisible                Boolean   @default(false)
  phoneVerifiedAt             DateTime?
  phoneVerificationCode       String?
  phoneVerificationExpiresAt  DateTime?

  membershipStatus    MembershipStatus @default(NONE)
  membershipExpiresAt DateTime?
  /// Gerçek ödeme durumundan bağımsız hızlı erişim bayrağı — üyelik ACTIVE
  /// olunca veya Erken Erişim/Beta döneminde true tutulur.
  isPremium           Boolean          @default(false)
  /// En son (aktif ya da geçmiş) planın önbelleği — abonelik geçmişi için
  /// hâlâ MembershipSubscription sorgulanır, bu sadece hızlı gösterim içindir.
  currentPlan         MembershipPlan?
  /// İlanına yeni bir başvuru geldiğinde e-posta bildirimi alınsın mı — Hesabım > Bildirimler'den yönetilir.
  notifyByEmail       Boolean          @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobPostings   JobPosting[]
  subscriptions MembershipSubscription[]
  conversations Conversation[]

  @@index([phone])
  @@map("company_profiles")
}

/// Tedarikçi hesabı — CANDIDATE/COMPANY'den ayrı, üçüncü bir kayıt rolü.
/// COMPANY gibi ücretli üyelik alır ama sadece inşaat malzemesi ilanı
/// (MaterialListing) verebilir, iş ilanı açamaz.
model SupplierProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String
  city        String
  district    String?
  /// Açık adres — sadece kullanıcının kendi Hesabım panelinde görünür.
  address     String?
  description String?
  authorizedPersonName String?
  taxOffice            String?
  taxNumber            String?
  mersisNumber         String?
  website              String?
  /// Hesabın giriş e-postasından bağımsız, isteğe bağlı firma iletişim e-postası.
  companyEmail         String?
  logoUrl              String?
  supplyCategories String[]

  phone                      String?
  /// Telefon numarasının başka kullanıcılara gösterilip gösterilmeyeceği —
  /// varsayılan kapalı, kullanıcı kendi rızasıyla açar.
  phoneVisible               Boolean   @default(false)
  phoneVerifiedAt            DateTime?
  phoneVerificationCode      String?
  phoneVerificationExpiresAt DateTime?

  membershipStatus    MembershipStatus @default(NONE)
  membershipExpiresAt DateTime?
  /// Gerçek ödeme durumundan bağımsız hızlı erişim bayrağı — üyelik ACTIVE
  /// olunca veya Erken Erişim/Beta döneminde true tutulur.
  isPremium           Boolean          @default(false)
  /// En son (aktif ya da geçmiş) planın önbelleği — abonelik geçmişi için
  /// hâlâ MembershipSubscription sorgulanır, bu sadece hızlı gösterim içindir.
  currentPlan         MembershipPlan?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  materialListings MaterialListing[]
  subscriptions    MembershipSubscription[]

  @@index([phone])
  @@map("supplier_profiles")
}

/// Taşeron firma hesabı — CANDIDATE/COMPANY/SUPPLIER'dan ayrı, dördüncü bir
/// kayıt rolü. Bireysel usta değil, faturalı/kurumsal iş yapan taşeron
/// firmaları temsil eder (örn. "kalıpçı taşeron firması"). COMPANY gibi
/// ücretli üyelik alır, dizin üzerinden diğer şirketler tarafından aranabilir.
model SubcontractorProfile {
  id                    String   @id @default(uuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName           String
  city                  String
  district              String?
  /// Açık adres — sadece kullanıcının kendi Hesabım panelinde görünür.
  address               String?
  tradeCategories       String[]
  description           String?
  authorizedPersonName  String?
  taxOffice             String?
  taxNumber             String?
  mersisNumber          String?
  website               String?
  /// Hesabın giriş e-postasından bağımsız, isteğe bağlı firma iletişim e-postası.
  companyEmail          String?
  logoUrl               String?
  isPublic              Boolean  @default(true)

  phone                      String?
  /// Telefon numarasının başka kullanıcılara gösterilip gösterilmeyeceği —
  /// varsayılan kapalı, kullanıcı kendi rızasıyla açar.
  phoneVisible               Boolean   @default(false)
  phoneVerifiedAt            DateTime?
  phoneVerificationCode      String?
  phoneVerificationExpiresAt DateTime?

  membershipStatus    MembershipStatus @default(NONE)
  membershipExpiresAt DateTime?
  /// Gerçek ödeme durumundan bağımsız hızlı erişim bayrağı — üyelik ACTIVE
  /// olunca veya Erken Erişim/Beta döneminde true tutulur.
  isPremium           Boolean          @default(false)
  /// En son (aktif ya da geçmiş) planın önbelleği — abonelik geçmişi için
  /// hâlâ MembershipSubscription sorgulanır, bu sadece hızlı gösterim içindir.
  currentPlan         MembershipPlan?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions MembershipSubscription[]

  @@index([isPublic, city, district])
  @@index([phone])
  @@map("subcontractor_profiles")
}

model MaterialListing {
  id           String                @id @default(uuid())
  supplierId   String
  supplier     SupplierProfile       @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  materialType String
  unit         String
  city         String
  district     String?
  price        Int
  photoUrl     String?
  description  String
  status       MaterialListingStatus @default(AVAILABLE)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([materialType, city, status])
  @@map("material_listings")
}

/// companyId, supplierId veya subcontractorId'den TAM OLARAK biri dolu olmalı
/// (uygulama katmanında denetlenir).
model MembershipSubscription {
  id              String                @id @default(uuid())
  companyId       String?
  company         CompanyProfile?       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplierId      String?
  supplier        SupplierProfile?      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  subcontractorId String?
  subcontractor   SubcontractorProfile? @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)
  plan            MembershipPlan
  status          MembershipStatus      @default(PENDING)

  iyzicoPricingPlanReferenceCode String?
  iyzicoSubscriptionReferenceCode String?
  checkoutToken                   String?

  /// Ödeme anındaki plan etiketi/fiyat metninin anlık görüntüsü — ileride
  /// MEMBERSHIP_PLANS içindeki fiyatlar değişse bile geçmiş kayıt o anki
  /// hâliyle kalır.
  planLabel      String?
  planPriceLabel String?

  /// initiateCheckout sırasında iyzico'ya gönderilen ama daha önce hiçbir
  /// yerde saklanmayan fatura bilgileri — "Faturalarım" geçmişinde gösterilir.
  identityNumber     String?
  billingContactName String?
  billingCity        String?
  billingAddress     String?
  billingZipCode     String?

  startedAt        DateTime?
  currentPeriodEnd DateTime?
  canceledAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([supplierId, status])
  @@index([subcontractorId, status])
  @@map("membership_subscriptions")
}

model JobPosting {
  id             String         @id @default(uuid())
  companyId      String
  company        CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title          String
  listingType    String         @default("PERSONNEL")
  tradeCategory  String
  city           String
  district       String?
  employmentType EmploymentType
  salaryMin      Int?
  salaryMax      Int?
  isUrgent       Boolean        @default(false)
  description    String
  status         JobStatus      @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  applications Application[]

  @@index([tradeCategory, city, status])
  @@index([isUrgent])
  @@map("job_postings")
}

model Application {
  id          String            @id @default(uuid())
  jobId       String
  job         JobPosting        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   CandidateProfile  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  message     String?
  status      ApplicationStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  conversation Conversation?
  reviews      Review[]

  @@unique([jobId, candidateId])
  @@map("applications")
}

/// Bir başvuru KABUL EDİLDİKTEN sonra (yani gerçekten bir çalışma ilişkisi
/// kurulduktan sonra) taraflar birbirine karşılıklı yıldız + yorum
/// bırakabilir — her taraf bir başvuru için en fazla bir yorum yazabilir.
/// Sistemde "iş tamamlandı" diye ayrı bir durum olmadığı için ACCEPTED en
/// yakın gerçek sinyal olarak kullanılır.
model Review {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  authorId      String
  author        User        @relation("AuthoredReviews", fields: [authorId], references: [id], onDelete: Cascade)
  targetUserId  String
  targetUser    User        @relation("ReceivedReviews", fields: [targetUserId], references: [id], onDelete: Cascade)
  /// 1-5 arası yıldız.
  rating        Int
  comment       String?
  createdAt     DateTime    @default(now())

  @@unique([applicationId, authorId])
  @@index([targetUserId])
  @@map("reviews")
}

/// Bir iş başvurusuna bağlı 1'e-1 mesajlaşma dizisi — açık bir forum/genel
/// mesajlaşma değil, sadece o başvurunun adayı ile ilanı açan firma arasında.
/// Telefon numarası paylaşımına (kendi rızası olmadan aranamama ilkesine)
/// alternatif/tamamlayıcı bir iletişim kanalıdır. İlk mesaj gönderildiğinde
/// gerektiğinde otomatik oluşturulur, ayrı bir "sohbet başlat" adımı yoktur.
model Conversation {
  id            String   @id @default(uuid())
  applicationId String   @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  /// Sorgu kolaylığı için Application üzerinden değil doğrudan tutulur.
  candidateId   String
  candidate     CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  companyId     String
  company       CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  messages Message[]

  @@index([candidateId])
  @@index([companyId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}

model WageSubmission {
  id              String          @id @default(uuid())
  tradeCategory   String
  city            String
  district        String?
  experienceLevel ExperienceLevel
  amount          Int
  period          WagePeriod
  submissionType  PriceSubmissionType @default(ACTUAL)
  submittedById   String
  submittedBy     User            @relation(fields: [submittedById], references: [id], onDelete: Cascade)
  /// Gönderenin kayıt telefonu — piyasayı yanıltacak tekrar girişleri önlemek
  /// için (phone, tradeCategory, city, experienceLevel, submissionMonth) eşsiz
  /// olmalı. experienceLevel dahil çünkü aynı kişi/firma junior ve senior ücreti
  /// ayrı ayrı bildirebilir — bu ayrı, geçerli veri noktalarıdır.
  phone           String
  /// "YYYY-MM" — gönderim anındaki ay, eşsizlik kısıtının ay bazlı çalışması için.
  submissionMonth String
  createdAt       DateTime        @default(now())

  @@unique([phone, tradeCategory, city, experienceLevel, submissionMonth])
  @@index([tradeCategory, city, createdAt])
  @@map("wage_submissions")
}

model MaterialPriceSubmission {
  id            String   @id @default(uuid())
  materialType  String
  unit          String
  city          String
  district      String?
  amount        Int
  submissionType PriceSubmissionType @default(ACTUAL)
  submittedById String
  submittedBy   User     @relation(fields: [submittedById], references: [id], onDelete: Cascade)
  /// Gönderenin kayıt telefonu — piyasayı yanıltacak tekrar girişleri önlemek
  /// için (phone, materialType, city, submissionMonth) eşsiz olmalı.
  phone         String
  /// "YYYY-MM" — gönderim anındaki ay, eşsizlik kısıtının ay bazlı çalışması için.
  submissionMonth String
  createdAt     DateTime @default(now())

  @@unique([phone, materialType, city, submissionMonth])
  @@index([materialType, city, createdAt])
  @@map("material_price_submissions")
}

enum FavoriteListingType {
  JOB
  EQUIPMENT
  MATERIAL_LISTING
  SITE_REQUEST
}

model Favorite {
  id          String              @id @default(uuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingType FavoriteListingType
  listingId   String
  createdAt   DateTime            @default(now())

  @@unique([userId, listingType, listingId])
  @@index([userId])
  @@map("favorites")
}

/// Kullanıcının Hesabım panelindeki adres defteri — hesap düzeyinde, tek
/// bir profile bağlı değil (ev/iş/firma/fatura gibi birden fazla adres
/// eklenebilir), aralarından biri varsayılan olarak işaretlenebilir.
model Address {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Kullanıcının kendi seçtiği serbest metin etiket — örn. "Ev", "İş", "Firma", "Fatura Adresi".
  label     String
  city      String
  district  String?
  /// Açık adres metni.
  line      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("addresses")
}

model EquipmentListing {
  id            String               @id @default(uuid())
  ownerId       String
  owner         User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  equipmentType String
  capacity      String?
  city          String
  district      String?
  listingType   EquipmentListingType @default(RENT)
  dailyRate     Int?
  hourlyRate    Int?
  salePrice     Int?
  photoUrl      String?
  description   String
  status        EquipmentStatus      @default(AVAILABLE)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([equipmentType, city, status])
  @@index([listingType])
  @@map("equipment_listings")
}

model SiteRequest {
  id            String            @id @default(uuid())
  createdById   String
  createdBy     User              @relation(fields: [createdById], references: [id], onDelete: Cascade)
  requestType   SiteRequestType
  tradeCategory String?
  equipmentType String?
  title         String
  description   String
  city          String
  district      String?
  latitude      Float
  longitude     Float
  neededCount   Int               @default(1)
  neededBy      DateTime?
  status        SiteRequestStatus @default(OPEN)
  createdAt     DateTime          @default(now())

  responses SiteRequestResponse[]

  @@index([city, status, requestType])
  @@map("site_requests")
}

model SiteRequestResponse {
  id            String                     @id @default(uuid())
  siteRequestId String
  siteRequest   SiteRequest                @relation(fields: [siteRequestId], references: [id], onDelete: Cascade)
  responderId   String
  responder     User                       @relation(fields: [responderId], references: [id], onDelete: Cascade)
  message       String?
  status        SiteRequestResponseStatus  @default(PENDING)
  createdAt     DateTime                   @default(now())

  @@unique([siteRequestId, responderId])
  @@map("site_request_responses")
}

/// Kullanıcıların meslek/malzeme/ekipman türü alanlarına serbestçe girip
/// kapalı listede olmayan yeni bir terim yazması durumunda oluşur (bkz. Akıllı
/// Doğrulama özelliği). Admin onaylayana kadar PENDING kalır; APPROVED
/// olduğunda /taxonomy/suggest sonuçlarına dahil edilir. Girişi yapan kullanıcının
/// ilanı/başvurusu bu onay sürecini beklemeden, girdiği ham metinle hemen oluşturulur.
model TaxonomyTerm {
  id              String             @id @default(uuid())
  type            TaxonomyTermType
  value           String
  normalizedValue String
  label           String
  status          TaxonomyTermStatus @default(PENDING)

  submittedByUserId String?
  submittedBy       User?   @relation("SubmittedTaxonomyTerms", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  reviewedByUserId  String?
  reviewedBy        User?   @relation("ReviewedTaxonomyTerms", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt        DateTime?

  createdAt DateTime @default(now())

  @@unique([type, normalizedValue])
  @@index([type, status])
  @@map("taxonomy_terms")
}

